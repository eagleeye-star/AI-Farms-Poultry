# Copy to `.env` for local dev. In Vercel add these under:
#   Project -> Settings -> Environment Variables  (then redeploy)
#
# Because these are baked in at BUILD time, you never type them on a
# device — you just sign in with email and password.
#
# These two values are safe to ship in the browser bundle. Every
# browser-based Supabase app does this. What protects your data is the
# login plus row-level security, which only returns rows belonging to
# the signed-in user.

VITE_SUPABASE_URL=https://your-project.supabase.co

# The ANON PUBLIC key. NEVER the service_role key — that one bypasses
# all security and must never reach the browser.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
